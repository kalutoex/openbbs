{
  "_说明": "模板。install.sh 会去掉所有 _ 开头的键再写成 config/site.json，真实配置里不留注释。改完不用改命令行，重启即生效。",
  "site": {
    "_说明": "站名、对外地址、身份。site_id 留空就用目录名；master_url 留空表示自己是主站，填了就是小站（跟着主站同步黑名单）。",
    "name": "OpenBBS",
    "description": "",
    "base_url": "",
    "site_id": "",
    "lang": "zh-Hans",
    "tags": [],
    "open": true,
    "contact": "",
    "master_url": ""
  },
  "server": {
    "_说明": "tls_cert_dir 填含 fullchain.pem 和 privkey.pem 的目录，填了就自己开 HTTPS；留空 = 明文，交给前面的 nginx 终止 TLS。",
    "host": "0.0.0.0",
    "port": 8080,
    "tls_cert_dir": ""
  },
  "safety": {
    "_说明": "sensitive 关掉后 config/sensitive.txt 整个不生效，发帖回帖不再查词；image_block 关掉后上传不查图片黑名单，管理接口仍可用。",
    "sensitive": true,
    "image_block": true
  },
  "auth": {
    "_说明": "public_key 是主站公钥，小站断网也能验主站签发的 token；register_challenge 打开后注册要答题，客户端得先支持再开。",
    "public_key": "",
    "blacklist_pull_seconds": 60,
    "register_challenge": false
  },
  "limits": {
    "_说明": "硬上限，服务端说了算。客户端压过图，超过 max_anim_mb 就是没压。",
    "per_page": 20,
    "floor_per_page": 20,
    "max_images": 9,
    "max_image_mb": 5,
    "max_anim_mb": 10,
    "title_max": 120,
    "body_max": 20000,
    "username_min": 2,
    "username_max": 20,
    "password_min": 8,
    "max_level": 99
  },
  "backup": {
    "_说明": "dir 留空 = data/backups。mirror_dir 填另一块盘上的目录做第二份，留空 = 只留本地一份；两份在同一块盘时日志会提醒。",
    "dir": "",
    "keep": 30,
    "mirror_dir": "",
    "mirror_keep": 14
  },
  "update": {
    "_说明": "只用来提示有新版本，不会自动升级。填 version.json 的地址。",
    "check_url": ""
  }
}
