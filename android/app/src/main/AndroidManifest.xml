<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 联网：装完就有，运行时不用问 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 通知：Android 13 起要运行时申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 上传保活：大文件要传十几分钟，人总要切出去干别的。
         没有前台服务，安卓一会儿就把进程冻住，上传就断了。
         只在上传期间挂一个通知，传完就撤。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- 应用内更新：装下载好的 apk -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- 相册：13 起读图片，12 及以下走旧权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- 手机文件浏览器：要翻整个存储，安卓 11 起只能在系统设置里给这个权限。
         只读不写，不删不改用户文件；不上架商店，自己分发，不涉及商店审核。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- 存图到相册：10 及以下要写权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <application
        android:label="OpenBBS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher_mint"
        android:roundIcon="@mipmap/ic_launcher_mint_round"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true">
        <!-- 入口全走下面的 activity-alias。安卓的桌面名字和图标只能写在清单里，
             运行时改不了，所以要让用户换图标，就得把几套图标预先声明成别名，
             再在运行时切换启用哪一个。主 Activity 自己不进桌面（enabled=false），
             否则会多出一个图标。
             加新图标：先跑 tool/gen_app_icons.py，再照抄一段 alias，
             Dart 侧的 app_icon.dart 里也要加。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>
        <activity-alias
            android:name=".IconMint"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="OpenBBS"
            android:icon="@mipmap/ic_launcher_mint"
            android:roundIcon="@mipmap/ic_launcher_mint_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBlue"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="OpenBBS"
            android:icon="@mipmap/ic_launcher_blue"
            android:roundIcon="@mipmap/ic_launcher_blue_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPurple"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="OpenBBS"
            android:icon="@mipmap/ic_launcher_purple"
            android:roundIcon="@mipmap/ic_launcher_purple_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPink"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="OpenBBS"
            android:icon="@mipmap/ic_launcher_pink"
            android:roundIcon="@mipmap/ic_launcher_pink_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCoral"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="OpenBBS"
            android:icon="@mipmap/ic_launcher_coral"
            android:roundIcon="@mipmap/ic_launcher_coral_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRed"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="OpenBBS"
            android:icon="@mipmap/ic_launcher_red"
            android:roundIcon="@mipmap/ic_launcher_red_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLime"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="OpenBBS"
            android:icon="@mipmap/ic_launcher_lime"
            android:roundIcon="@mipmap/ic_launcher_lime_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSteel"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="OpenBBS"
            android:icon="@mipmap/ic_launcher_steel"
            android:roundIcon="@mipmap/ic_launcher_steel_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- 上传时挂个前台服务，进程才不会被系统冻住 -->
        <service
            android:name=".UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
